VITE_POSTHOG_PROJECT_TOKEN=phc_your_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Partner coupon API (/api/partner-coupons). Format: name:key,name2:key2
# Generate a key with: openssl rand -hex 32
PARTNER_API_KEYS=partnerA:replace_with_long_random_key
# Fixed by us (defaults shown). The partner chooses discount type/value/expiry per request.
PARTNER_COUPON_MIN_ORDER=350
# Optional safety caps in case a partner key leaks (defaults shown; 0 = no cap for fixed amount)
PARTNER_MAX_PERCENT=100
PARTNER_MAX_FIXED_AMOUNT=0
PARTNER_MAX_VALID_DAYS=365
