# Preserve your existing production campaign/payment/tracking environment.
PORT=3001
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Server only. Never prefix this with VITE_ or include it in browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SERVICE_KEY
# Enable on staging only; remove/set false on production.
SEO_STAGING=true
# Optional: copy only existing training-specific robots groups unchanged.
# Supply actual newlines through your hosting environment's secret/config UI.
ROBOTS_TRAINING_RULES=
# Development proxy only; production uses the existing Express app directly.
API_PROXY_TARGET=http://127.0.0.1:3001
